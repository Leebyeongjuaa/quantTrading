# Copy to .env (never commit .env). Read by lighter-cli via dotenvy.
# Your Lighter account index (shown in the app / GET /api/v1/account?by=l1_address&value=0x...)
LIGHTER_ACCOUNT_INDEX=
# API key slot 4..254 (0-3 are reserved for Lighter's own apps). Default 4.
LIGHTER_API_KEY_INDEX=4
# 40-byte hex private key generated with `lighter-cli gen-key` and registered via ChangePubKey.
LIGHTER_API_KEY_PRIVATE=
# Optional overrides (defaults come from --network mainnet|testnet)
# LIGHTER_REST_URL=https://mainnet.zklighter.elliot.ai
# LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream
# LIGHTER_CHAIN_ID=304
